rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedInAs(uid) {
      return request.auth != null && request.auth.uid == uid;
    }
    function validDisplayName(name) {
      return name is string && name.size() > 0 && name.size() <= 24
        && name == name.trim() && name.matches('[^/]+')
        && name != '.' && name != '..' && !name.matches('__.*__');
    }
    function reservedBy(uid, name) {
      let key = name.lower();
      let reservation = getAfter(/databases/$(database)/documents/usernames/$(key)).data;
      return reservation.uid == uid && reservation.displayName == name;
    }
    function usernameMigrationReady() {
      return get(/databases/$(database)/documents/config/usernameMigration).data.ready == true;
    }
    function validEntry() {
      let data = request.resource.data;
      return data.keys().hasAll(['uid', 'name', 'clearedStages', 'turnsToLastClear', 'killDifference', 'enemyDefeated', 'playerDefeated', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'name', 'clearedStages', 'turnsToLastClear', 'killDifference', 'enemyDefeated', 'playerDefeated', 'updatedAt'])
        && data.uid == request.auth.uid
        && validDisplayName(data.name)
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.displayName == data.name
        && reservedBy(request.auth.uid, data.name)
        && data.clearedStages is int && data.clearedStages >= 0 && data.clearedStages <= 1000
        && (data.turnsToLastClear == null || (data.turnsToLastClear is int && data.turnsToLastClear >= 0))
        && data.killDifference is int
        && data.enemyDefeated is int && data.enemyDefeated >= 0
        && data.playerDefeated is int && data.playerDefeated >= 0;
    }
    match /users/{uid} {
      allow read: if signedInAs(uid);
      allow create: if signedInAs(uid)
        && usernameMigrationReady()
        && validDisplayName(request.resource.data.displayName)
        && reservedBy(uid, request.resource.data.displayName);
      allow delete: if signedInAs(uid);
    }
    match /config/{id} {
      allow get: if id == 'usernameMigration' && request.auth != null;
    }
    match /usernames/{key} {
      allow get: if request.auth != null;
      allow list: if request.auth != null && resource.data.uid == request.auth.uid;
      allow create: if request.auth != null
        && usernameMigrationReady()
        && request.resource.data.keys().hasAll(['uid', 'displayName'])
        && request.resource.data.keys().hasOnly(['uid', 'displayName'])
        && request.resource.data.uid == request.auth.uid
        && validDisplayName(request.resource.data.displayName)
        && key == request.resource.data.displayName.lower()
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.displayName == request.resource.data.displayName;
      allow delete: if request.auth != null
        && resource.data.uid == request.auth.uid
        && !existsAfter(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    match /leaderboards/{season}/entries/{uid} {
      allow read: if true;
      allow create, update: if signedInAs(uid) && validEntry();
      allow delete: if signedInAs(uid);
    }
  }
}
